# LeafSense AI Backend - Environment Variables Configuration
# Copy this file to .env and fill in the values for development.

# Application Configuration
APP_NAME="LeafSense AI"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True

# Security Configuration
# WARNING: Always change JWT_SECRET in production to a secure random 32-byte hexadecimal string.
# You can generate one via: openssl rand -hex 32
JWT_SECRET="db5a9ef22e86bfd7b5bf3b8cd09641ab3e46c72e2d9cd7de28e67a7d42cf3891"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Database Configuration (PostgreSQL Docker/Local setup)
DB_USER="leafsense_admin"
DB_PASSWORD="leafsense_secure_pass_2026"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="leafsense_db"

# SQLAlchemy database connection string
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
