# ==============================================================================
# LeafSense AI - Production Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and modify settings according to the target environment.
# All database configuration, security credentials, and routing are managed here.

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# The master database username used for local development and Docker orchestration.
POSTGRES_USER=leafsense_admin

# The master database password. WARNING: Always change this in staging/production environments!
POSTGRES_PASSWORD=leafsense_secure_pass_2026

# The target database name created within the database instance.
POSTGRES_DB=leafsense_db

# The external port mapped on the host system to connect to the database container.
# Defaults to 5434 to avoid conflicts with native PostgreSQL servers running on 5432/5433.
POSTGRES_PORT=5434

# ------------------------------------------------------------------------------
# pgAdmin Database Management Console Settings
# ------------------------------------------------------------------------------
# Default username (email) for authenticating to the pgAdmin UI console dashboard.
PGADMIN_DEFAULT_EMAIL=admin@leafsense.ai

# Default login password for the pgAdmin UI console dashboard. WARNING: Always change this in production!
PGADMIN_DEFAULT_PASSWORD=pgadmin_secure_pass_2026

# The port exposed on the host machine to access pgAdmin in the browser (http://localhost:5050).
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# FastAPI Backend Core Security Settings
# ------------------------------------------------------------------------------
# JWT Authentication Secret. MUST be changed in production to a secure random 32-byte hex string.
# Can be generated using the command: openssl rand -hex 32
JWT_SECRET=db5a9ef22e86bfd7b5bf3b8cd09641ab3e46c72e2d9cd7de28e67a7d42cf3891

# The encryption algorithm used to sign authentication access tokens.
JWT_ALGORITHM=HS256

# Expiration duration in minutes for access tokens (1440 minutes = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Authorized CORS Origins. Comma-separated list of domains allowed to request API data.
# E.g. BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# Compiled Database Connection URL
# ------------------------------------------------------------------------------
# Primary connection string loaded by the backend's SQLAlchemy engine.
# Inside Docker Compose network, 'db' refers to the postgres service host name.
# When deploying to Amazon RDS, only this URL needs to be modified to target the RDS instance.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
