# ==============================================================================
# LeafSense AI - Core environment settings for Docker Compose Orchestration
# ==============================================================================

# PostgreSQL configuration
POSTGRES_USER=leafsense_admin
POSTGRES_PASSWORD=leafsense_secure_pass_2026
POSTGRES_DB=leafsense_db
POSTGRES_PORT=5432

# pgAdmin configuration
PGADMIN_DEFAULT_EMAIL=admin@leafsense.ai
PGADMIN_DEFAULT_PASSWORD=pgadmin_secure_pass_2026
PGADMIN_PORT=5050

# Backend FastAPI settings
JWT_SECRET=db5a9ef22e86bfd7b5bf3b8cd09641ab3e46c72e2d9cd7de28e67a7d42cf3891
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL used by backend within the docker network (references 'db' host)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
